# Get it from https://www.agent37.com/dashboard/cloud/api-keys
AGENT37_API_KEY=sk_live_replace_me

# YOUR Composio project's API key — https://platform.composio.dev → project → API key.
# Server-only: it never reaches the browser or an agent instance (agents get a revocable
# per-agent proxy token instead). Leave blank to run without integrations.
COMPOSIO_API_KEY=

# Get it from https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_replace_me

# Filled in by `npm run setup` — leave blank for a fresh free project, or paste an
# existing project's values (Project Settings -> API) to use that one instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Also filled in by `npm run setup`. Server-only (no NEXT_PUBLIC_ prefix) — never commit it
# or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# The public URL of THIS app. Two jobs: (1) auth email redirects in production, and (2) the
# Composio MCP proxy URL written into every agent's config — agents run in Agent37's cloud, so
# they can only call back here if this URL is publicly reachable. Leave it blank in dev:
# `npm run dev` auto-starts a cloudflared quick tunnel when COMPOSIO_API_KEY is set, and agents
# wire/re-wire themselves. In production set your stable URL and re-run `npm run setup` (it
# registers the auth redirect too).
# NEXT_PUBLIC_SITE_URL=https://your-app.com
